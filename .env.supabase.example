# ==========================================
# PROVEEDOR CLOUD B: SUPABASE POSTGRESQL
# ==========================================
# En el VPS AWS, estas variables se cargan desde /opt/taskflow/.env.nestjs
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://tu-dominio.com

# --- PARA NODE.JS (NestJS / Fastify + Prisma ORM) ---
# Puerto 6543 = Supavisor Transaction Pooler | Puerto 5432 = Direct Connection para migraciones
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# --- PARA PYTHON (FastAPI + SQLAlchemy / psycopg3) ---
SQLALCHEMY_DATABASE_URL="postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
ALEMBIC_DIRECT_URL="postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"