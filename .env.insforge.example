# ==========================================
# PROVEEDOR CLOUD A: INSFORGE POSTGRESQL
# ==========================================
# En el VPS AWS, estas variables se cargan desde /opt/taskflow/.env.nestjs
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://tu-dominio.com

# --- PARA NODE.JS (NestJS / Fastify + Prisma ORM) ---
# DATABASE_URL usa el pooler de conexiones (puerto 6543); DIRECT_URL se usa para prisma migrate deploy (puerto 5432)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER-HOST.insforge.cloud:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-HOST.insforge.cloud:5432/postgres?sslmode=require"

# --- PARA PYTHON (FastAPI + SQLAlchemy / psycopg3) ---
# App runtime (pooler) y Alembic migraciones (directo)
SQLALCHEMY_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@POOLER-HOST.insforge.cloud:6543/postgres?sslmode=require"
ALEMBIC_DIRECT_URL="postgresql+psycopg://USER:PASSWORD@DIRECT-HOST.insforge.cloud:5432/postgres?sslmode=require"